  "private": true,
  "main": "src/server.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "docker compose exec -T postgres psql -U postgres -d tutoring_scheduling -f - < db/schema.sql",
    "seed": "tsx src/seed/index.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
